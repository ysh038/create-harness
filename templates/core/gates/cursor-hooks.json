{
    "version": 1,
    "hooks": {
        "beforeShellExecution": [
            {
                "command": "./.harness/gates/before-shell-gate.sh cursor"
            }
        ],
        "preToolUse": [
            {
                "command": "./.harness/gates/pre-write-gate.sh cursor",
                "matcher": "Write|StrReplace|Edit|ApplyPatch",
                "failClosed": true
            }
        ]
    }
}
